rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // --------------------------------------------------------------------------------
    // REUSABLE AUTH & ROLE FUNCTIONS
    // --------------------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function getUserRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'SUPER_ADMIN';
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'ADMIN';
    }
    
    function isCoreStaff() {
      return isSuperAdmin() || isAdmin();
    }
    
    function isInspector() {
      return isAuthenticated() && getUserRole() == 'INSPECTOR';
    }
    
    function isOrganization() {
      return isAuthenticated() && getUserRole() == 'ORGANIZATION';
    }
    
    // --------------------------------------------------------------------------------
    // FILE VALIDATION FUNCTIONS
    // --------------------------------------------------------------------------------
    function isValidSize() {
      // Restrict files to 20MB
      return request.resource.size < 20 * 1024 * 1024;
    }
    
    function isValidContentType() {
      // Allow Images, PDFs, JSONs (for reports), and basic video formats
      return request.resource.contentType.matches('image/.*') || 
             request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/json') ||
             request.resource.contentType.matches('video/.*');
    }

    // --------------------------------------------------------------------------------
    // DEFAULT DENY
    // --------------------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // --------------------------------------------------------------------------------
    // 1. INSPECTION EVIDENCE
    // --------------------------------------------------------------------------------
    match /inspection-evidence/{inspectionId}/{findingId}/{fileName} {
      // Core staff have full access to read
      allow read: if isCoreStaff();
      
      // Inspector can read/write only if they are actively assigned to this inspection
      allow read, create: if isInspector() 
        && firestore.get(/databases/(default)/documents/inspections/$(inspectionId)).data.inspectorId == request.auth.uid
        && isValidSize() 
        && isValidContentType();
        
      // Organizations can view the evidence for their own inspections
      allow read: if isOrganization()
        && firestore.get(/databases/(default)/documents/inspections/$(inspectionId)).data.organizationId == request.auth.uid;
    }

    // --------------------------------------------------------------------------------
    // 2. ORGANIZATION DOCUMENTS
    // --------------------------------------------------------------------------------
    match /documents/{organizationId}/{fileName} {
      // Core staff have full access
      allow read: if isCoreStaff();
      
      // Organizations can read and upload documents only to their exact folder
      allow read, create: if isOrganization() 
        && request.auth.uid == organizationId
        && isValidSize() 
        && isValidContentType();
        
      // Inspectors may need to read organizational documents (like registration certs) during inspections
      allow read: if isInspector();
    }

    // --------------------------------------------------------------------------------
    // 3. REPORTS
    // --------------------------------------------------------------------------------
    match /reports/{inspectionId}/{fileName} {
      // Core staff have full access
      allow read: if isCoreStaff();
      
      // Inspector can read reports generated for their inspections
      allow read: if isInspector()
        && firestore.get(/databases/(default)/documents/inspections/$(inspectionId)).data.inspectorId == request.auth.uid;
        
      // Organizations can read reports generated for their inspections
      allow read: if isOrganization()
        && firestore.get(/databases/(default)/documents/inspections/$(inspectionId)).data.organizationId == request.auth.uid;
        
      // Reports are typically generated by Firebase Cloud Functions (Admin SDK bypasses rules).
      // However, if manual uploads are permitted, restrict to core staff.
      allow create: if isCoreStaff() 
        && isValidSize() 
        && isValidContentType();
    }
  }
}
